cat > .gitignore <<'EOF'
# dependencies
node_modules/
.pnp/
.pnpm-store/

# Next.js
.next/
out/

# env
.env
.env.*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/

# Go
bin/
dist/
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# Docker
**/.dockerignore
EOF

